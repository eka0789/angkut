# Lihat sistem produksi Angkut.
# Letakkan di /etc/nginx/sites-available/angkut dan symlink ke sites-enabled.

upstream angkut_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

upstream angkut_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Rate limit edge sebagai lapis pertama (aplikasi tetap punya rate limit sendiri).
limit_req_zone $binary_remote_addr zone=angkut_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=angkut_track:10m rate=1r/s;

server {
    listen 80;
    server_name angkut.id www.angkut.id;
    # Cloudflare/Let's Encrypt menangani TLS; redirect permanen ke HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name angkut.id www.angkut.id;

    # Sertifikat dikelola Cloudflare Origin / Let's Encrypt.
    ssl_certificate     /etc/ssl/angkut/fullchain.pem;
    ssl_certificate_key /etc/ssl/angkut/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 25m;   # unggahan CSV/XLSX bulk & lampiran

    # ── API ──────────────────────────────────────────────────────────────
    location /api/ {
        limit_req zone=angkut_api burst=40 nodelay;

        proxy_pass         http://angkut_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        # Streaming (SSE) & WebSocket untuk pelacakan realtime.
        proxy_buffering off;
    }

    # Server-Sent Events: jangan buffer.
    location /api/v1/tracking/ {
        proxy_pass         http://angkut_api;
        proxy_http_version 1.1;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;
    }

    location /api/v1/ws {
        proxy_pass         http://angkut_api;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 3600s;
    }

    # Tracking publik: batas ketat per IP (endpoint tanpa login).
    location /api/v1/public/track/ {
        limit_req zone=angkut_track burst=5 nodelay;
        proxy_pass       http://angkut_api;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── Web (Nuxt SSR) ───────────────────────────────────────────────────
    location / {
        proxy_pass         http://angkut_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Cache aset statis Nuxt.
    location /_nuxt/ {
        proxy_pass http://angkut_web;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}