# Angkut — contoh konfigurasi. SALIN ke .env lalu sesuaikan.
# JANGAN commit .env. Tidak ada nilai rahasia produksi di file ini.

# ─── Umum ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_NAME=angkut
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=debug                     # debug | info | warn | error
API_PORT=8080
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=angkut
POSTGRES_PASSWORD=angkut
POSTGRES_DB=angkut
POSTGRES_PORT=5432
DATABASE_URL=postgres://angkut:angkut@localhost:5432/angkut?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ────────────────────────────────────────────────────────────
RABBITMQ_USER=angkut
RABBITMQ_PASSWORD=angkut
RABBITMQ_VHOST=angkut
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://angkut:angkut@localhost:5672/angkut

# ─── Object storage (S3-compatible / MinIO) ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=angkut
S3_ACCESS_KEY=angkutminio
S3_SECRET_KEY=angkutminio123
S3_REGION=idn
S3_USE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ─── Mail (dev: Mailpit menangkap semua email) ───────────────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@angkut.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Auth / session ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ─── Integrasi vendor (KOSONG = mode mock, platform tetap jalan) ─────────
COURIER_ADAPTER=mock                # mock | aggregator | direct
COURIER_AGREGATOR_KEY=
COURIER_AGREGATOR_BASE_URL=
STORE_ADAPTER=mock                  # mock | shopee | tokopedia
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
PAYMENT_ADAPTER=mock                # mock | midtrans | xendit
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
AI_PROVIDER=mock                    # mock | openai_compatible
AI_API_KEY=
AI_MODEL=
WHATSAPP_ADAPTER=mock               # mock | gateway
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# ─── Observability ───────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true

# ─── Rate limit (default; dapat dioverride per endpoint) ─────────────────
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_PUBLIC_TRACK_PER_MIN=30

# --- Pricing engine (TASK-023) - semua angka dari konfigurasi ---
PRICING_VOLUMETRIC_DIVISOR=6000
PRICING_WEIGHT_ROUND_STEP_KG=0.1
PRICING_MAX_CHARGEABLE_KG=100
# Fee COD = persentase nilai COD (basis points: 100 = 1%).
PRICING_COD_FEE_RATE_BPS=100
PRICING_COD_FEE_MIN=2500
# Asuransi = persentase nilai barang (basis points: 20 = 0.2%).
PRICING_INSURANCE_RATE_BPS=20
PRICING_INSURANCE_MIN_FEE=2500
# Markup platform per shipment (flat IDR) + persentase harga dasar (bps).
PRICING_MARKUP_FLAT=0
PRICING_MARKUP_RATE_BPS=0
# Pembulatan harga akhir ke kelipatan (IDR).
PRICING_PRICE_ROUND_STEP=100
# ─── Keamanan tambahan (Phase 2) ─────────────────────────────────────────
# Kunci enkripsi rahasia at-rest (TOTP secret). 32 byte base64.
# Buat dengan: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# Menandatangani parameter state OAuth (anti-CSRF). Wajib diubah di produksi.
OAUTH_STATE_SECRET=dev-oauth-state-secret-change-me-32ch

# ─── Google OAuth (kosongkan bila belum dipakai) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
